      "DistanceEMAATR",
      "EMASlope5ATR",
      "EMASlope10ATR",
      "RecentRangePositionDir",
      "TickVolume",
      "TimeOfDaySin",
      "TimeOfDayCos",
      "DayOfWeekSin",
      "DayOfWeekCos",
      "MinutesFromSessionOpen",
      "MinutesToSessionClose",
      "DirectionalRoomATR"
    ],
    "boolean": [
      "AsiaSession",
      "LondonSession",
      "NewYorkSession"
    ],
    "categorical": [
      "CciSignalType",
      "LateConfirmMask",
      "DataIntegrityFlag"
    ],
    "forbidden": [
      "RunId",
      "SetupId",
      "StrategyVersion",
      "SourceRevision",
      "PresetHash",
      "Symbol",
      "Timeframe",
      "CandidateTime",
      "CandidateBarTime",
