      "STMTFLatencyNativeBars",
      "STMTFLatencySeconds",
      "HiLoAgeBars",
      "PsarAgeBars",
      "STAgeBars",
      "STMTFAgeBars",
      "Return1ATR",
      "Return3ATR",
      "Return5ATR",
      "Return10ATR",
      "Return20ATR",
